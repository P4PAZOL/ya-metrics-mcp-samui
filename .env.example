# OAuth-токен Яндекс ID со скоупом metrika:read.
# Как выпустить — см. README_samui.md, раздел «Выпуск токена».
# Значение сюда НЕ вписывать: этот файл в git, а .env — нет.
YANDEX_API_KEY=

# Необязательное
YANDEX_TIMEOUT=30
YANDEX_RETRIES=3
YANDEX_RETRY_DELAY=1.0

# READ_ONLY_MODE и ENABLED_TOOLS в апстриме объявлены, но НЕ РАБОТАЮТ:
# filter_tools() вызывается только из тестов, а сервер регистрирует тулы
# декораторами при импорте модуля, минуя всякую фильтрацию. В этом форке
# набор урезан физически — в src/ya_metrics_mcp/servers/tools.py оставлено
# семь инструментов из тридцати одного, и это закреплено тестом.
# Переменные оставлены на случай, если апстрим доведёт фильтрацию до
# рабочего состояния.
# READ_ONLY_MODE=true
# ENABLED_TOOLS=

# --- Журнал вызовов в панель samui-guide (опционально) ---
# После каждого вызова инструмента обёртка шлёт POST с фактом вызова на
# эндпоинт Django, откуда его показывает панель /cms/metrika/.
# Не задано — логирование молча выключено, сервер работает как обычно.
#
# METRIKA_LOG_SECRET — ЭТО НЕ ТОКЕН МЕТРИКИ. YANDEX_API_KEY выше открывает
# всю статистику сайта; этот секрет позволяет лишь писать в журнал. Разные
# назначения, разная цена компрометации — не переиспользовать один вместо
# другого.
# METRIKA_LOG_ENDPOINT_URL=https://samuiguide.ru/api/metrika/log/
# METRIKA_LOG_SECRET=
# METRIKA_LOG_TIMEOUT=3.0
